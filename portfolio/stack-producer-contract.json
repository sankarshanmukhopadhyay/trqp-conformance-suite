{
  "contract_version": "1.1",
  "producer": {
    "repository": "sankarshanmukhopadhyay/trqp-conformance-suite",
    "role": "protocol-conformance-and-replay-producer"
  },
  "consumer": "sankarshanmukhopadhyay/trqp-assurance-hub",
  "required_correlators": ["run_id", "target_id"],
  "required_outputs": [
    {
      "type": "conformance-evidence",
      "requirement": "Machine-readable protocol conformance result"
    },
    {
      "type": "profile-consumable-conformance-evidence",
      "requirement": "Version-bound CTS core/binding evidence suitable for profile-aware Hub composition without profile reinterpretation"
    },
    {
      "type": "replay-determinism-report",
      "requirement": "Machine-readable semantic replay equivalence result"
    },
    {
      "type": "replay-comparison-policy",
      "requirement": "Versioned comparison policy identity and digest"
    }
  ],
  "integrity": {
    "version_or_commit_provenance_required": true,
    "comparison_policy_digest_required": true,
    "artifact_hashing_required_by_stack_release": true,
    "profile_consumption_requires_test_set_revision": true,
    "profile_metadata_must_not_change_core_results": true
  },
  "invalidation_conditions": [
    "missing required output",
    "run_id mismatch",
    "target_id mismatch",
    "schema-invalid evidence",
    "protocol or binding mismatch",
    "test-set revision mismatch where applicability depends on the changed tests",
    "reassessment required or invalid evidence presented as current",
    "failed replay determinism",
    "unrecognised replay comparison policy",
    "unsupported semantic or schema authority"
  ],
  "authority_boundary": {
    "owns": ["protocol conformance execution", "CTS evidence semantics", "replay comparison policy", "replay determinism verdict", "profile-consumable projection of CTS-owned evidence"],
    "does_not_own": ["ecosystem profile policy", "TSPP control definitions", "combined assurance decision", "governance legitimacy", "coordinated stack release declaration"]
  }
}
