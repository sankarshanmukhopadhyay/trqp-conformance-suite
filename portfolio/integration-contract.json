{
  "contractVersion": "1.0",
  "repository": "sankarshanmukhopadhyay/trqp-conformance-suite",
  "release": "1.8.0",
  "role": "conformance-test-authority",
  "authority": {
    "semanticAuthority": {
      "repository": "sankarshanmukhopadhyay/trust-systems-meta-model",
      "version": "0.24.0",
      "artifacts": [
        "bindings/trqp/tsmm-trqp-binding.json",
        "model/semantic-concepts.json",
        "schemas/semantic-projection.schema.json"
      ]
    },
    "schemaAuthority": {
      "repository": "sankarshanmukhopadhyay/trust-infrastructure-schemas",
      "version": "0.14.1",
      "artifacts": [
        "portfolio/portfolio-relationship.schema.json",
        "portfolio/repository-authority.schema.json",
        "portfolio/portfolio-validation-result.schema.json"
      ]
    }
  },
  "provides": [
    "TRQP requirement conformance results",
    "negative-test coverage",
    "deterministic execution evidence"
  ],
  "consumes": [
    "TRQP-TSPP normative requirements and assurance-level semantics",
    "TSMM TRQP semantic binding",
    "TIS conformance and portfolio contracts"
  ],
  "evidence": [
    {"path": "artifacts/traceability/cts-requirement-coverage.json", "purpose": "requirement coverage"},
    {"path": "artifacts/traceability/negative-test-coverage.json", "purpose": "negative-test coverage"},
    {"path": "policies/replay-determinism.v1.json", "purpose": "replay determinism policy"},
    {"path": "schemas/evidence/replay-determinism-report.schema.json", "purpose": "replay determinism report contract"}
  ],
  "relationships": [
    {"repository": "sankarshanmukhopadhyay/TRQP-TSPP", "relation": "tests"},
    {"repository": "sankarshanmukhopadhyay/trqp-assurance-hub", "relation": "feeds-evidence-to"}
  ],
  "revocation": {
    "triggers": [
      "semantic-authority-version-incompatible",
      "schema-authority-version-incompatible",
      "required-evidence-missing",
      "normative-source-version-incompatible",
      "replay-determinism-policy-incompatible"
    ],
    "effect": "integration-status-invalid"
  }
}
